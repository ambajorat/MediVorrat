        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ per day"
          }
        }
      }
    },
    "%@. Einmal zuordnen, danach erkennt die App sie selbst." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Assign it once and the app will recognise it from then on."
