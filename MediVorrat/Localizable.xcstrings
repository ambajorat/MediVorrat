            "value" : "Health data is not available on this device."
          }
        }
      }
    },
    "Auf diesem Gerät ist kein iCloud-Konto angemeldet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No iCloud account is signed in on this device."
